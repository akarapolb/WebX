# Dependencies
node_modules/
**/node_modules/

# Strapi (secrets, build output, local DB, uploaded media)
strapi-cms/.env
strapi-cms/.tmp/
strapi-cms/dist/
strapi-cms/build/
strapi-cms/.cache/
strapi-cms/.strapi/
strapi-cms/public/uploads/*
!strapi-cms/public/uploads/.gitkeep
**/*.db
**/*.sqlite

# Logs
*.log
npm-debug.log*

# Generated deck QA previews (PowerPoint COM PNG export)
site/DGA-Website/bid/deck-assets/

# Next.js / WebX Studio (env + build handled by webx-studio/.gitignore too)
webx-studio/.next/
webx-studio/.env.local

# Next.js / public-site (static export output + env)
public-site/.next/
public-site/out/
public-site/.env.local

# OS / editor
.DS_Store
Thumbs.db
*.swp

# production compose env (never commit)
/.env
