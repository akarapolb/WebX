# WebX Studio — production env for docker-compose. Copy to `.env` and fill in.
# NEVER commit the filled-in .env. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# ── Database (Postgres + pgvector) ───────────────────────────────────────────
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=            # REQUIRED — a strong password

# ── Strapi secrets (REQUIRED) ────────────────────────────────────────────────
# APP_KEYS = 2+ comma-separated random keys.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# ── Ports (host side) ────────────────────────────────────────────────────────
STRAPI_PORT=1337
WEBX_PORT=3000
LITELLM_PORT=4000

# ── AI gateway (optional — leave LITELLM_URL empty to disable AI) ─────────────
# When using the bundled litellm service: LITELLM_URL=http://litellm:4000
LITELLM_URL=
LITELLM_KEY=
LITELLM_MASTER_KEY=
# Provider keys consumed by the litellm service (set only what you use):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── RAG vector store (optional) ──────────────────────────────────────────────
# Empty = in-app cosine (uses Strapi). 'pgvector' = use the Postgres below.
WEBX_VECTOR=
PGVECTOR_URL=postgres://strapi:CHANGE_ME@db:5432/strapi
