# WebX Studio — production env for docker-compose. Copy to `.env` and fill in.
# NEVER commit the filled-in .env. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# ── Database (Postgres + pgvector) ───────────────────────────────────────────
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=            # REQUIRED — a strong password
# TLS in transit to the DB (config/database.ts already wires this for both
# postgres/mysql — off by default so local dev/docker-compose's own
# unencrypted DB link keeps working). Turn on for any deployment where
# Strapi and the database are NOT on the same trusted private network (TOR
# Security: encryption in transit). Leave DATABASE_SSL_CA unset to trust the
# platform's default CA bundle (fine for most managed DB providers).
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ── Strapi secrets (REQUIRED) ────────────────────────────────────────────────
# APP_KEYS = 2+ comma-separated random keys.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
# Strapi's OWN built-in /admin/login rate limiter (config/admin.ts) —
# defaults to 20 attempts per 10-minute window, per (email, path, ip). The
# un-set Strapi default is a much tighter 5-per-5-min, which repeatedly
# blocked normal operation in dev (the seeded scheduler service account
# re-authenticating as part of its own token-refresh cycle counts as
# "attempts" the same as a human typing a wrong password). Tighten these if
# this deployment wants stricter brute-force protection than the default.
ADMIN_LOGIN_RATE_LIMIT_MAX=20
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MIN=10
# AES-256-GCM key (32 raw bytes, base64) encrypting PII at rest on
# contact-message/registration (src/utils/pii-crypto.ts) — REQUIRED, citizen
# name/email/phone are stored encrypted, not plaintext (PDPA). Deliberately
# separate from ENCRYPTION_KEY (Strapi core's own, above) and from
# WEBX_ENCRYPTION_KEY (webx-studio's, below) — different security domains,
# do not reuse. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# ── Internal service-to-service secret (REQUIRED) ────────────────────────────
# Protects strapi's GET /api/internal/tenant-of and
# /api/internal/custom-role-permissions routes — service-to-service calls,
# not admin sessions. strapi reads this as WEBX_INTERNAL_SECRET, webx and
# wordpress both read the same value as STRAPI_INTERNAL_SECRET/
# WEBX_INTERNAL_SECRET respectively (same value, three env-var names across
# three services — see strapi-cms/.env.example's own comment). Only used by
# wordpress if the wordpress profile is enabled.
STRAPI_INTERNAL_SECRET=

# ── Ports (host side) ────────────────────────────────────────────────────────
STRAPI_PORT=1337
WEBX_PORT=3000
LITELLM_PORT=4000

# ── Public site CORS ──────────────────────────────────────────────────────────
# The real production domain(s) public-site is served from, comma-separated —
# needed for its browser-side calls (the cookie-consent banner, and any
# future client-side Strapi call) to pass CORS. Leave blank if you're not
# deploying public-site separately from this stack.
WEBX_PUBLIC_SITE_ORIGINS=

# ── Release scheduler (REQUIRED for scheduled Releases to ever fire) ─────────
# The release-scheduler service ticks POST /api/internal/releases/process-due
# on an interval; WEBX_SCHEDULER_SECRET protects that route, and
# STRAPI_SCHEDULER_PASSWORD is what the seeded scheduler service account logs
# in with (both webx and strapi read the SAME value below — keep them equal).
# Generate each with the command at the top of this file. If you never use
# scheduled Releases (only "Publish now"), these can be left as any non-empty
# placeholder — the scheduler will just have nothing to do.
WEBX_SCHEDULER_SECRET=
STRAPI_SCHEDULER_PASSWORD=
RELEASE_SCHEDULER_INTERVAL_SECONDS=60
# Only needed if a scheduled release ever contains a WordPress-backed item —
# an Application Password from that WordPress instance's own
# Users → Profile → Application Passwords screen. Same account as
# WORDPRESS_SCHEDULER_USERNAME below when the wordpress profile is enabled.
WORDPRESS_SCHEDULER_USERNAME=
WORDPRESS_SCHEDULER_APP_PASSWORD=

# ── Backups (nightly Postgres dump + uploads volume, local disk) ────────────
# The db-backup service runs strapi-cms/scripts/backup-db.js on this
# interval, writing into the db-backups Docker volume on THIS host — not
# off-site. That's a real gap on its own (a host-level disaster still loses
# both the data and its backups) — point this volume at network storage, or
# add an off-site sync step, before relying on it as your only copy.
BACKUP_KEEP=30
BACKUP_INTERVAL_SECONDS=86400

# ── SSO / Keycloak (optional — only start Keycloak itself with: ─────────────
#     docker compose --profile keycloak up -d keycloak
#   Only needed if any tenant enables SSO in its Single Sign-On settings
#   page. Skip this whole section if no tenant uses SSO.) ────────────────────
KEYCLOAK_PORT=8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=         # REQUIRED (if using the keycloak profile) — a strong password
# AES-256-GCM key (32 raw bytes, base64) webx-studio uses to encrypt each
# tenant's Keycloak client secret and JIT-provisioned shadow Strapi
# passwords at rest — REQUIRED if any tenant enables SSO. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBX_ENCRYPTION_KEY=
# Deprovisioning sync (sso-reconcile-scheduler service, governance.ts's
# reconcileSsoDeprovisioning) — reuses the SAME KEYCLOAK_ADMIN/
# KEYCLOAK_ADMIN_PASSWORD above (webx's own service block reads them too),
# nothing new to set here. How often it checks each SSO tenant's realm for
# users removed/disabled in Keycloak and deactivates their WebX access
# (or reactivates it if they reappear) — doesn't need release-scheduler's
# 60s promptness.
SSO_RECONCILE_INTERVAL_SECONDS=900

# ── WordPress engine (optional — only start it with: ─────────────────────────
#     docker compose --profile wordpress up -d --build
#   Only needed if any tenant uses engine:"wordpress", e.g. an ORST- or
#   RoyalSociety-style tenant. Skip this whole section if every tenant is
#   Strapi-engine.) ─────────────────────────────────────────────────────────
WORDPRESS_PORT=8081
# The real public URL this WordPress will be served at (behind HTTPS — this
# deployment, unlike docker-compose.wordpress.yml's dev instance, does NOT
# relax the Application-Passwords-require-HTTPS check). Must be reachable
# from wherever an admin logs into wp-admin, e.g. https://cms.example.gov.
WORDPRESS_SITE_URL=
WORDPRESS_SITE_TITLE=WebX WordPress
WORDPRESS_DB_ROOT_PASSWORD=      # REQUIRED — a strong password, its own MySQL instance (separate from the Postgres above)
WORDPRESS_DB_PASSWORD=           # REQUIRED — a strong password
# The account the bootstrap script creates on first boot — same one
# WORDPRESS_SCHEDULER_USERNAME above should reference once you've created
# its Application Password (see this file's own comment above).
WORDPRESS_ADMIN_PASSWORD=        # REQUIRED — a strong password, WordPress's real interactive admin login
WORDPRESS_ADMIN_EMAIL=
# Phase 7 — native WordPress polls/complaints/applications/breaking-news
# (mu-plugins/pii-crypto.php, public-forms-api.php). AES-256-GCM key (32 raw
# bytes, base64) encrypting complaint/application name/email/phone at rest —
# REQUIRED for any tenant using these forms (PDPA). Deliberately separate
# from strapi's own PII_ENCRYPTION_KEY and webx-studio's WEBX_ENCRYPTION_KEY
# — different security domains, do not reuse. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBX_WP_PII_KEY=
# Same SMTP_* names strapi's own email plugin already reads (see the Strapi
# secrets section above, if this file documents it) — one shared SMTP_* set
# in the host env configures outbound mail for both engines identically.
# Leave SMTP_HOST blank to no-op (wp_mail() silently fails, logged not
# thrown) rather than crash.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@orst.go.th
# Fallback staff-notify address for new complaints when a tenant has no
# entry of its own in wp-admin's Settings → WebX Forms screen.
COMPLAINT_NOTIFY_EMAIL=
# public-site's own browser-side calls (poll vote, breaking-news poll,
# complaint/application/contact-message submit, captcha) need the PUBLIC
# WordPress URL inlined at build time — set on whatever builds public-site,
# not this compose stack itself if public-site is built/deployed separately.
NEXT_PUBLIC_WORDPRESS_URL=

# ── AI gateway (optional — leave LITELLM_URL empty to disable AI) ─────────────
# When using the bundled litellm service: LITELLM_URL=http://litellm:4000
LITELLM_URL=
LITELLM_KEY=
LITELLM_MASTER_KEY=
# Provider keys consumed by the litellm service (set only what you use):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── RAG vector store (optional) ──────────────────────────────────────────────
# Empty = in-app cosine (uses Strapi). 'pgvector' = use the Postgres below.
WEBX_VECTOR=
PGVECTOR_URL=postgres://strapi:CHANGE_ME@db:5432/strapi
