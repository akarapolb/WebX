# WebX Studio — production env for docker-compose. Copy to `.env` and fill in.
# NEVER commit the filled-in .env. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# ── Database (Postgres + pgvector) ───────────────────────────────────────────
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=            # REQUIRED — a strong password
# TLS in transit to the DB (config/database.ts already wires this for both
# postgres/mysql — off by default so local dev/docker-compose's own
# unencrypted DB link keeps working). Turn on for any deployment where
# Strapi and the database are NOT on the same trusted private network (TOR
# Security: encryption in transit). Leave DATABASE_SSL_CA unset to trust the
# platform's default CA bundle (fine for most managed DB providers).
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ── Reverse proxy trust (only if you actually have one in front) ────────────
# Off by default — Strapi then uses the raw socket address for the caller's
# IP everywhere it matters (rate limiting, the traffic log พ.ร.บ.คอมพิวเตอร์
# retention requires). Set to true ONLY when Strapi genuinely sits behind a
# reverse proxy you control that sets X-Forwarded-For itself (DEPLOY.md's
# "HTTPS/TLS terminated in front" step) — otherwise any external client can
# forge that header and forge the IP address these rely on. Found
# unconditionally trusted (with no way to turn it off) in a full-codebase
# audit (2026-09-12).
TRUST_PROXY=false

# ── Strapi secrets (REQUIRED) ────────────────────────────────────────────────
# APP_KEYS = 2+ comma-separated random keys.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
# Strapi's OWN built-in /admin/login rate limiter (config/admin.ts) —
# defaults to 20 attempts per 10-minute window, per (email, path, ip). The
# un-set Strapi default is a much tighter 5-per-5-min, which repeatedly
# blocked normal operation in dev (the seeded scheduler service account
# re-authenticating as part of its own token-refresh cycle counts as
# "attempts" the same as a human typing a wrong password). Tighten these if
# this deployment wants stricter brute-force protection than the default.
ADMIN_LOGIN_RATE_LIMIT_MAX=20
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MIN=10
# AES-256-GCM key (32 raw bytes, base64) encrypting PII at rest on
# contact-message/registration (src/utils/pii-crypto.ts) — REQUIRED, citizen
# name/email/phone are stored encrypted, not plaintext (PDPA). Deliberately
# separate from ENCRYPTION_KEY (Strapi core's own, above) and from
# WEBX_ENCRYPTION_KEY (webx-studio's, below) — different security domains,
# do not reuse. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# ── Demo MFA on Strapi's native /admin UI (optional) ─────────────────────────
# utils/mfa.ts — TOTP + HMAC-signed cookie gating direct browser navigation
# to /admin (NOT the real per-user MFA in webx-studio's own login, and NOT a
# gate on the admin login API itself — just the SPA shell). Previously never
# wired through to the container at all, so a value here was silently
# ignored and the code's own hardcoded fallback (a literal well-known
# example TOTP secret) always applied — found in a full-codebase audit
# (2026-09-12). Set real values if you want this to mean anything, or set
# MFA_ENABLED=false if you'd rather not rely on it (it doesn't protect the
# real admin login regardless).
MFA_ENABLED=true
MFA_SECRET=
MFA_COOKIE_SECRET=

# ── Internal service-to-service secret (REQUIRED) ────────────────────────────
# Protects strapi's GET /api/internal/tenant-of and
# /api/internal/custom-role-permissions routes — service-to-service calls,
# not admin sessions. strapi reads this as WEBX_INTERNAL_SECRET, webx and
# wordpress both read the same value as STRAPI_INTERNAL_SECRET/
# WEBX_INTERNAL_SECRET respectively (same value, three env-var names across
# three services — see strapi-cms/.env.example's own comment). Only used by
# wordpress if the wordpress profile is enabled.
STRAPI_INTERNAL_SECRET=

# ── Ports (host side) ────────────────────────────────────────────────────────
STRAPI_PORT=1337
WEBX_PORT=3000
LITELLM_PORT=4000

# ── Public site CORS ──────────────────────────────────────────────────────────
# The real production domain(s) public-site is served from, comma-separated —
# needed for its browser-side calls (the cookie-consent banner, and any
# future client-side Strapi call) to pass CORS. Leave blank if you're not
# deploying public-site separately from this stack.
WEBX_PUBLIC_SITE_ORIGINS=

# ── Release scheduler (REQUIRED for scheduled Releases to ever fire) ─────────
# The release-scheduler service ticks POST /api/internal/releases/process-due
# on an interval; WEBX_SCHEDULER_SECRET protects that route, and
# STRAPI_SCHEDULER_PASSWORD is what the seeded scheduler service account logs
# in with (both webx and strapi read the SAME value below — keep them equal).
# Generate each with the command at the top of this file. If you never use
# scheduled Releases (only "Publish now"), these can be left as any non-empty
# placeholder — the scheduler will just have nothing to do.
WEBX_SCHEDULER_SECRET=
STRAPI_SCHEDULER_PASSWORD=
RELEASE_SCHEDULER_INTERVAL_SECONDS=60

# ── Bundled demo-tenant editors (REQUIRED) ───────────────────────────────────
# seed.ts's seedEditors creates dga-editor@dga.local / pea-editor@pea.local
# on every boot for the two reference tenants this repo ships with. These
# used to have a hardcoded, public password with no override at all — found
# in a full-codebase audit (2026-09-12). Set real values here; a strong
# password, not the repo's own documented dev default.
DGA_EDITOR_PASSWORD=
PEA_EDITOR_PASSWORD=
# Only needed if a scheduled release ever contains a WordPress-backed item —
# an Application Password from that WordPress instance's own
# Users → Profile → Application Passwords screen. Same account as
# WORDPRESS_SCHEDULER_USERNAME below when the wordpress profile is enabled.
WORDPRESS_SCHEDULER_USERNAME=
WORDPRESS_SCHEDULER_APP_PASSWORD=

# ── WordPress per-tenant sign-in accounts ──────────────────────────────────
# Every WordPress-engine tenant needs a real WordPress account for its
# editors to sign into WebX Studio with. wordpress/bootstrap.sh creates the
# ones listed here on every start, idempotently, so they no longer live only
# inside the wp-db-data volume — before this, a fresh clone or a
# `docker compose down -v` left the tenant locked out with nothing in the
# repo recording that the account had ever existed.
#
# The tenant key is upper-cased into the variable names below, so "orst"
# reads WORDPRESS_ORST_*. Leave the list empty to create nothing.
WORDPRESS_TENANT_USERS=orst royalsociety

WORDPRESS_ORST_USERNAME=orst-editor
WORDPRESS_ORST_EMAIL=orst-editor@example.go.th
# Only used when the account is first created — wp-admin sign-in.
WORDPRESS_ORST_PASSWORD=
# What WebX Studio actually authenticates with: it sends this as HTTP Basic
# against /wp-json, which WordPress accepts ONLY as an application password,
# never the normal one. MUST be alphanumeric — WordPress strips every other
# character from a submitted application password before checking it, so a
# value with punctuation could never sign in. Leave blank to have one
# generated on first boot and printed to `docker compose logs wp-cli`; set it
# here to keep the same credential across a rebuilt volume.
WORDPRESS_ORST_APP_PASSWORD=
# Defaults to administrator, matching how these accounts were first set up by
# hand. Tenant isolation is enforced by WebX's own governance and the
# custom-role mu-plugin rather than by the WordPress role.
WORDPRESS_ORST_ROLE=

WORDPRESS_ROYALSOCIETY_USERNAME=royalsociety-editor
WORDPRESS_ROYALSOCIETY_EMAIL=royalsociety-editor@example.go.th
WORDPRESS_ROYALSOCIETY_PASSWORD=
WORDPRESS_ROYALSOCIETY_APP_PASSWORD=
WORDPRESS_ROYALSOCIETY_ROLE=

# ── Backups (nightly Postgres dump + uploads volume, local disk) ────────────
# The db-backup service runs strapi-cms/scripts/backup-db.js on this
# interval, writing into the db-backups Docker volume on THIS host — not
# off-site. That's a real gap on its own (a host-level disaster still loses
# both the data and its backups) — point this volume at network storage, or
# add an off-site sync step, before relying on it as your only copy.
BACKUP_KEEP=30
BACKUP_INTERVAL_SECONDS=86400

# ── SSO / Keycloak (optional — only start Keycloak itself with: ─────────────
#     docker compose --profile keycloak up -d keycloak
#   Only needed if any tenant enables SSO in its Single Sign-On settings
#   page. Skip this whole section if no tenant uses SSO.) ────────────────────
KEYCLOAK_PORT=8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=         # REQUIRED (if using the keycloak profile) — a strong password
# AES-256-GCM key (32 raw bytes, base64) webx-studio uses to encrypt each
# tenant's Keycloak client secret and JIT-provisioned shadow Strapi
# passwords at rest — REQUIRED if any tenant enables SSO. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBX_ENCRYPTION_KEY=
# Deprovisioning sync (sso-reconcile-scheduler service, governance.ts's
# reconcileSsoDeprovisioning) — reuses the SAME KEYCLOAK_ADMIN/
# KEYCLOAK_ADMIN_PASSWORD above (webx's own service block reads them too),
# nothing new to set here. How often it checks each SSO tenant's realm for
# users removed/disabled in Keycloak and deactivates their WebX access
# (or reactivates it if they reappear) — doesn't need release-scheduler's
# 60s promptness.
SSO_RECONCILE_INTERVAL_SECONDS=900

# ── WordPress engine (optional — only start it with: ─────────────────────────
#     docker compose --profile wordpress up -d --build
#   Only needed if any tenant uses engine:"wordpress", e.g. an ORST- or
#   RoyalSociety-style tenant. Skip this whole section if every tenant is
#   Strapi-engine.) ─────────────────────────────────────────────────────────
WORDPRESS_PORT=8081
# The real public URL this WordPress will be served at (behind HTTPS — this
# deployment, unlike docker-compose.wordpress.yml's dev instance, does NOT
# relax the Application-Passwords-require-HTTPS check). Must be reachable
# from wherever an admin logs into wp-admin, e.g. https://cms.example.gov.
WORDPRESS_SITE_URL=
WORDPRESS_SITE_TITLE=WebX WordPress
WORDPRESS_DB_ROOT_PASSWORD=      # REQUIRED — a strong password, its own MySQL instance (separate from the Postgres above)
WORDPRESS_DB_PASSWORD=           # REQUIRED — a strong password
# The account the bootstrap script creates on first boot — same one
# WORDPRESS_SCHEDULER_USERNAME above should reference once you've created
# its Application Password (see this file's own comment above).
WORDPRESS_ADMIN_PASSWORD=        # REQUIRED — a strong password, WordPress's real interactive admin login
WORDPRESS_ADMIN_EMAIL=
# Phase 7 — native WordPress polls/complaints/applications/breaking-news
# (mu-plugins/pii-crypto.php, public-forms-api.php). AES-256-GCM key (32 raw
# bytes, base64) encrypting complaint/application name/email/phone at rest —
# REQUIRED for any tenant using these forms (PDPA). Deliberately separate
# from strapi's own PII_ENCRYPTION_KEY and webx-studio's WEBX_ENCRYPTION_KEY
# — different security domains, do not reuse. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBX_WP_PII_KEY=
# Same SMTP_* names strapi's own email plugin already reads (see the Strapi
# secrets section above, if this file documents it) — one shared SMTP_* set
# in the host env configures outbound mail for both engines identically.
# Leave SMTP_HOST blank to no-op (wp_mail() silently fails, logged not
# thrown) rather than crash.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@orst.go.th
# Fallback staff-notify address for new complaints when a tenant has no
# entry of its own in wp-admin's Settings → WebX Forms screen.
COMPLAINT_NOTIFY_EMAIL=
# public-site's own browser-side calls (poll vote, breaking-news poll,
# complaint/application/contact-message submit, captcha) need the PUBLIC
# WordPress URL inlined at build time — set on whatever builds public-site,
# not this compose stack itself if public-site is built/deployed separately.
NEXT_PUBLIC_WORDPRESS_URL=

# ── AI gateway (optional — leave LITELLM_URL empty to disable AI) ─────────────
# When using the bundled litellm service: LITELLM_URL=http://litellm:4000
LITELLM_URL=
LITELLM_KEY=
# REQUIRED if you use the bundled litellm service (the "ai" compose
# profile) — LiteLLM treats an unset/empty master key as "no auth required"
# on its own endpoints, so leaving this blank means the gateway (holding
# your real provider API keys below) is reachable by anyone who can reach
# its port with zero auth. Found in a full-codebase audit (2026-09-12);
# docker-compose.yml now hard-fails at startup if this is unset while the
# "ai" profile is active. Generate it with the command at the top of this
# file, same as any other secret here.
LITELLM_MASTER_KEY=
# Provider keys consumed by the litellm service (set only what you use):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Moonshot AI (webx-kimi model, litellm/config.yaml) — the international
# platform (api.moonshot.ai), not the .cn one; that key won't work here.
MOONSHOT_API_KEY=
# webx-embed model (litellm/config.yaml) — the oneweb.tech ML sandbox's
# TEI-style embeddings endpoint. REQUIRED for AI Search's real vectors;
# docker-compose.yml has forwarded it to the litellm service all along, but
# this file never documented it, so it could only be discovered by reading
# the compose file.
MLSANDBOX_EMB_API_KEY=
# Which litellm/config.yaml alias every AI feature routes to (lib/llm.ts,
# lib/agent/runtime.ts). Unset means webx-default — anthropic/claude-sonnet-4-5
# falling back to gemini — so set this explicitly if those aren't the
# providers you have keys for above.
LITELLM_MODEL=

# ── RAG vector store (optional) ──────────────────────────────────────────────
# Empty = in-app cosine (uses Strapi). 'pgvector' = use the Postgres below.
WEBX_VECTOR=
# A real-looking connection string here (the old default was
# postgres://strapi:CHANGE_ME@db:5432/strapi) is too easy to copy verbatim
# without noticing it needs a real password — found in a full-codebase
# audit (2026-09-12). Left genuinely blank instead; fill in the real
# connection string only when WEBX_VECTOR=pgvector above.
PGVECTOR_URL=

# ── Billing (optional — leave STRIPE_SECRET_KEY empty to keep self-serve Pro
# checkout disabled; Enterprise stays sales-assisted regardless) ─────────────
# All four are required together for a real launch:
STRIPE_SECRET_KEY=
# The Price id (price_...) for Pro's $79/mo recurring price, from the Stripe
# Dashboard — not a product id, and Enterprise has no Price id at all.
STRIPE_PRICE_ID_PRO=
# REQUIRED alongside STRIPE_SECRET_KEY — the signing secret for the Stripe
# Dashboard webhook endpoint pointed at https://<your-domain>/api/webhooks/stripe.
# Without this, that route 503s and no subscription state (upgrade, payment
# failure, cancellation) ever reaches a tenant's record after checkout.
STRIPE_WEBHOOK_SECRET=
# Publishable key — reaches the browser bundle, this one is not secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Public website (profile "site") — see docs/ORST-PUBLIC-SITE-DEPLOYMENT.md ─
# Run with: docker compose --profile ai --profile wordpress --profile site up -d --build
# Bare domains => Caddy obtains/renews HTTPS certificates itself. DNS A/AAAA for
# BOTH names must point at this host, and ports 80/443 must be open.
SITE_ADDRESS=www.example.go.th
CMS_ADDRESS=cms.example.go.th
SITE_PUBLIC_URL=https://www.example.go.th
# Baked into the pages at BUILD time and called by visitors' browsers.
SITE_WORDPRESS_PUBLIC_URL=https://cms.example.go.th/wp-json
SITE_STUDIO_ORIGIN=https://studio.example.go.th
SITE_ROOT_TENANTS=orst
SITE_HTTP_PORT=80
SITE_HTTPS_PORT=443
# Strapi CORS for the public site (also listed above, under "Public site CORS").
# WEBX_PUBLIC_SITE_ORIGINS=https://www.example.go.th
# WordPress sits behind the Caddy above, which terminates TLS:
WP_TRUST_PROXY_HTTPS=1
# Studio talks to WordPress with Application Passwords, which WordPress refuses
# over plain HTTP — and WP_ALLOW_HTTP_APP_PASSWORDS must NOT be set in production.
# So Studio goes through the public HTTPS name (tested: the internal
# http://wordpress:80 URL gets 401 once that bypass is off).
WEBX_WORDPRESS_URL=https://cms.example.go.th/wp-json
# Host ports for Studio / WordPress default to 127.0.0.1 (not reachable from the
# network). Put Studio behind its own TLS/SSO if editors need it remotely; do not
# set these to 0.0.0.0 on an internet-facing host.
# WEBX_BIND=127.0.0.1
# WORDPRESS_BIND=127.0.0.1
# WORDPRESS_SITE_URL (above) must be https://cms.example.go.th — and on an
# EXISTING WordPress database it is NOT applied automatically (bootstrap skips
# `core install`); run once:
#   docker compose exec wp-cli wp option update home    https://cms.example.go.th --allow-root
#   docker compose exec wp-cli wp option update siteurl https://cms.example.go.th --allow-root
# The new mu-plugin also has to be copied into an existing wp-content volume:
#   docker compose cp wordpress/mu-plugins/proxy-https.php wordpress:/var/www/html/wp-content/mu-plugins/
# SITE_ALIAS is for local/LAN trials only (SITE_ALIAS=:80 serves the site for any Host,
# e.g. a LAN IP). Leave it UNSET in production.
