# public-site — static-export Next.js app for the WordPress-engine tenants
# (ORST, RoyalSociety). Copy to .env.local and adjust. Never commit .env.local.
#
# Both vars below have fallback defaults matching the standard local dev
# setup (docker-compose's WordPress on :8081, webx-studio on :3000), so a
# fresh clone builds and runs with zero config. Only set these if your local
# ports differ, or when building for a real deployment.

# WordPress REST API base URL — used client-side (poll voting, breaking-news
# banner, captcha) and at build time (page/menu/content fetches). See
# lib/useCaptcha.ts, templates/orst/PollBlock.tsx, components/BreakingNewsBanner.tsx.
# Defaults to http://localhost:8081/wp-json.
NEXT_PUBLIC_WORDPRESS_URL=

# Allowed parent origin(s) for the Visual Builder's postMessage preview
# bridge (comma-separated) — see templates/_builder/PreviewBridge*.tsx.
# Defaults to http://localhost:3000 (webx-studio's dev origin).
NEXT_PUBLIC_STUDIO_ORIGIN=
