# public-site — static-export Next.js app for the WordPress-engine tenants
# (ORST, RoyalSociety). Copy to .env.local and adjust. Never commit .env.local.
#
# Both vars below have fallback defaults matching the standard local dev
# setup (docker-compose's WordPress on :8081, webx-studio on :3000), so a
# fresh clone builds and runs with zero config. Only set these if your local
# ports differ, or when building for a real deployment.

# WordPress REST API base URL the BUILD reads (page/menu/content fetches,
# lib/cms.ts). Defaults to http://localhost:8081/wp-json.
WORDPRESS_URL=

# WordPress address the VISITOR'S BROWSER calls (poll voting, breaking-news
# banner, site search, captcha, forms). Leave unset: it follows WORDPRESS_URL,
# except that a build for a public PUBLIC_SITE_URL against a localhost
# WordPress switches these calls off (lib/publicCmsRule.mjs). Set it to the
# hosted WordPress (…/wp-json) for a real deployment, or "off".
# (NEXT_PUBLIC_WORDPRESS_URL, the older name, is still read when set.)
PUBLIC_WORDPRESS_URL=

# The WebX control plane (webx-control) as the VISITOR'S BROWSER reaches it. When set, the cookie banner posts its choice
# to <PUBLIC_CONTROL_URL>/api/consent-logs, the search box reports to /api/search-stats/log, the forms (contact, complaint,
# application, registration) and their captcha use /api/complaints, /api/captcha and the rest, and the contact lookup reads
# /api/tenants/resolve, instead of calling the CMS (PUBLIC_CMS_URL). The assistant still calls the CMS. No default; unset keeps
# every call on the CMS. Forms need webx-control to be started with WEBX_PII_KEY (and WEBX_SMTP_URL for the mail they send). The control plane must allow this site's
# origin: WEBX_PUBLIC_SITE_ORIGINS on webx-control (webx-control/README.md, "Visitors' routes"). Not WEBX_CONTROL_URL,
# which is the address the BUILD reads tenants from.
PUBLIC_CONTROL_URL=

# Allowed parent origin(s) for the Visual Builder's postMessage preview
# bridge (comma-separated) — see templates/_builder/PreviewBridge*.tsx.
# Defaults to http://localhost:3000 (webx-studio's dev origin).
NEXT_PUBLIC_STUDIO_ORIGIN=

# Tenants whose content lives on a different engine than STRAPI_URL (for
# example a Rust-engine tenant): a JSON map of tenant key -> engine base URL,
# e.g. WEBX_ENGINE_URLS='{"dgahub":"http://localhost:1338"}'. Build time only.
# That tenant's pages are read from its engine and the relative media URLs in
# them (/uploads/...) are made absolute against the same engine; tenants not
# listed use STRAPI_URL. Any engine of kind strapi or rust answers the same
# read API. WEBX_CONTROL_URL (the tenant list from webx-control) is separate.
WEBX_ENGINE_URLS=
