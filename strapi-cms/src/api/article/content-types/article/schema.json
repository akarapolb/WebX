{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "ข่าวและบทความ (DGA News / บทความ)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "kind": {
      "type": "enumeration",
      "enum": ["news", "article"],
      "default": "news",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "categoryLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "excerpt": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "body": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "publishDate": {
      "type": "date",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "views": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
