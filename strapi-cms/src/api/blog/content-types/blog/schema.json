{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": { "singularName": "blog", "pluralName": "blogs", "displayName": "Blog", "description": "บล็อก (TOR ภาคผนวก ก ข้อ 15)" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title" },
    "category": { "type": "string" },
    "excerpt": { "type": "text" },
    "body": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" } },
    "coverImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "author": { "type": "string" },
    "publishDate": { "type": "date" },
    "views": { "type": "integer", "default": 0 },
    "tags": { "type": "json", "description": "แท็กสำหรับการค้นหา (TOR ข้อ 4.2)" },
    "tenant": { "type": "relation", "relation": "manyToOne", "target": "api::tenant.tenant" }
  }
}
