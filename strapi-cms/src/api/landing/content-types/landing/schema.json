{
  "kind": "collectionType",
  "collectionName": "landings",
  "info": {
    "singularName": "landing",
    "pluralName": "landings",
    "displayName": "Landing",
    "description": "หน้า Landing/Splash สร้างแบบ no-code ด้วยการวางบล็อก (Dynamic Zone)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "seoDescription": {
      "type": "text"
    },
    "enterSiteLabel": {
      "type": "string",
      "description": "ข้อความปุ่มเข้าสู่เว็บหลัก (TOR ข้อ 26.3)"
    },
    "enterSiteUrl": {
      "type": "string",
      "default": "index.html"
    },
    "publishStart": {
      "type": "datetime",
      "description": "ตั้งเวลาเริ่มแสดง Landing (TOR ข้อ 26.4)"
    },
    "publishEnd": {
      "type": "datetime",
      "description": "ตั้งเวลาสิ้นสุดแสดง Landing"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "block.hero",
        "block.richtext",
        "block.image",
        "block.cta-banner",
        "block.feature-grid"
      ]
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant"
    }
  }
}
