    "email": { "type": "email" },
    "phone": { "type": "string" },
    "subject": { "type": "string" },
    "message": { "type": "text", "required": true },
    "handled": { "type": "boolean", "default": false },
    "tenant": { "type": "relation", "relation": "manyToOne", "target": "api::tenant.tenant" }
  }
