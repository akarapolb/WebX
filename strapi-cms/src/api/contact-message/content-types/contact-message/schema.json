{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": { "singularName": "contact-message", "pluralName": "contact-messages", "displayName": "Contact Message", "description": "ข้อความติดต่อจากแบบฟอร์ม Contact Us (TOR ภาคผนวก ก ข้อ 11.2)" },
  "options": { "draftAndPublish": false },
