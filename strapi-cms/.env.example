HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Shared secret for webx-studio's internal cross-tenant ownership lookup
# (GET /api/internal/tenant-of, src/api/internal). Must match webx-studio's
# STRAPI_INTERNAL_SECRET exactly.
WEBX_INTERNAL_SECRET=tobemodified

# AES-256-GCM key (32 raw bytes, base64) for PII encryption-at-rest on
# contact-message/registration (src/utils/pii-crypto.ts). Deliberately a
# separate key from the ENCRYPTION_KEY above (that one is Strapi core's own,
# config/admin.ts) and from webx-studio's WEBX_ENCRYPTION_KEY — different
# security domains. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# Real GA4 Data API pull for the Analytics dashboard's "external analytics"
# panel (src/utils/ga4.ts) — optional; when unset, that panel just echoes
# back whatever tracking id a tenant's own `analytics` field carries, same as
# before this existed. Both must be set together. GA4_SERVICE_ACCOUNT_EMAIL
# is the service account's client_email; GA4_SERVICE_ACCOUNT_KEY is its
# private_key (from the same Google Cloud service-account JSON key file,
# Analytics Admin API access granted as a Viewer on the real GA4 property) —
# paste the PEM including "-----BEGIN/END PRIVATE KEY-----" and its "\n"
# escapes exactly as the JSON file has them. Also set the tenant's own
# `analytics.ga4PropertyId` (the numeric Property ID, not the "G-XXXX"
# measurement id) via the admin API/UI to actually enable the pull for that
# tenant.
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_KEY=
