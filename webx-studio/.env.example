# WebX Studio — backend-agnostic: point at ANY Strapi instance.
# Copy to .env.local and adjust. Never commit .env.local.
STRAPI_URL=http://localhost:1337

# WordPress content backend (Phase 2) — which engine an admin session talks
# to is now chosen per-login (the login page's Strapi/WordPress toggle) and
# resolved from the target tenant's own `engine` field, not a global switch —
# see lib/cms/governance.ts's activeAdapter(). WordPress needs an Application
# Password issued to a real WP user (Users -> Profile -> Application Passwords).
WORDPRESS_URL=http://localhost:8081/wp-json
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Cookie names for the BFF session (httpOnly). Token never reaches the browser.
WEBX_SESSION_COOKIE=webx_session
# Which engine the session cookie above authenticates against — set at login,
# see lib/strapi.ts's sessionEngine().
WEBX_ENGINE_COOKIE=webx_session_engine

# Shared secret for governance.ts's internal cross-tenant ownership lookup
# (GET /api/internal/tenant-of on the Strapi side — see strapi-cms/src/api/internal).
# Must match strapi-cms/.env's WEBX_INTERNAL_SECRET exactly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
STRAPI_INTERNAL_SECRET=

# AES-256-GCM key (32 raw bytes, base64) for lib/crypto.ts — encrypts
# per-tenant Keycloak client secrets and JIT-provisioned shadow Strapi
# passwords at rest (SSO login, see lib/cms/governance.ts's ssoLogin).
# Required if any tenant enables SSO. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBX_ENCRYPTION_KEY=

# AES-256-GCM key (32 raw bytes, base64) for WordPress-engine tenants'
# complaint/application PII (name/email/phone) — decrypt-on-read here, mirrors
# wordpress/mu-plugins/pii-crypto.php's own encrypt-on-write. MUST equal that
# WordPress container's own WEBX_WP_PII_KEY exactly (see
# docker-compose.wordpress.yml's WEBX_WP_PII_KEY dev fallback for local dev) —
# a mismatch doesn't degrade gracefully, every complaint/application list
# 500s outright (found live: this var was undocumented and unset here,
# silently hiding real citizen complaints/applications from ORST/RoyalSociety
# admins). Required for any WordPress-engine tenant using those forms.
WEBX_WP_PII_KEY=

# Phase 5 — release scheduler (POST /api/internal/releases/process-due).
# WEBX_SCHEDULER_SECRET protects the route itself (whatever external cron
# calls it must send it as X-Internal-Secret); the STRAPI_SCHEDULER_* and
# WORDPRESS_SCHEDULER_* pairs are the service account(s) the route logs in as
# to actually publish, since it has no browser session/cookie to use.
# STRAPI_SCHEDULER_* must match strapi-cms's seeded scheduler account
# (strapi-cms/src/seed/seed.ts's seedScheduler). WORDPRESS_SCHEDULER_* only
# matters if you use scheduled releases with WordPress-backed items.
WEBX_SCHEDULER_SECRET=
STRAPI_SCHEDULER_EMAIL=scheduler@webx.local
STRAPI_SCHEDULER_PASSWORD=
WORDPRESS_SCHEDULER_USERNAME=
WORDPRESS_SCHEDULER_APP_PASSWORD=

# Idle/session lifetime in seconds (mirrors Strapi admin session TTL).
WEBX_SESSION_TTL=1800

# Phase 7 — auto-rebuild the public static site on publish/unpublish (see
# lib/publicSiteBuild.ts, called from lib/cms/governance.ts). Auto-detects
# the sibling public-site/ directory; override PUBLIC_SITE_DIR if it lives
# elsewhere. Set PUBLIC_SITE_AUTO_REBUILD=off to disable entirely.
PUBLIC_SITE_DIR=
PUBLIC_SITE_AUTO_REBUILD=
PUBLIC_SITE_REBUILD_DEBOUNCE_MS=

# Visual Builder's real preview (components/blockPreview/RealPreview.tsx) —
# public-site's own base URL, so the preview iframe can load its real CSS
# (design-system.css/templates.css/home.css) by absolute URL. NEXT_PUBLIC_
# because it's read from a client component. Defaults to localhost:3100.
NEXT_PUBLIC_PUBLIC_SITE_URL=

# LLM-agnostic AI gateway (LiteLLM proxy, OpenAI-compatible). See ../litellm/README.md.
# Leave LITELLM_URL empty to disable AI (features degrade gracefully).
LITELLM_URL=
LITELLM_KEY=
LITELLM_MODEL=webx-default
LITELLM_EMBED_MODEL=webx-embed

# WebX Agent (docked chat panel + full-page workspace, lib/agent/*). Off by
# default even with LITELLM_URL set — an admin must also grant a workspace
# (or role) an autonomy level above "off" via Agent Settings before it runs
# for anyone. Set to 0 to hard-disable the feature workspace-wide regardless
# of any per-tenant policy (e.g. while rolling it out).
AGENT_ENABLED=1

# WebX Agent background jobs (lib/agent/worker.ts). Each webx process runs a
# worker unless AGENT_WORKER_ENABLED=0; several processes can share one Strapi
# safely (jobs are leased). A workspace admin must still turn on "Background
# jobs" in Agent settings, and the plan must allow them. Needs
# STRAPI_INTERNAL_SECRET and the STRAPI_SCHEDULER_* service account above.
AGENT_WORKER_ENABLED=1
# Jobs one process runs at the same time.
AGENT_WORKER_CONCURRENCY=3
# Model turns per slice before a job goes back to the queue so others get a turn.
AGENT_SLICE_TURNS=8
# Schedules (recurring jobs) start when something calls
# POST /api/internal/agent/tick with X-Internal-Secret: $WEBX_SCHEDULER_SECRET,
# about once a minute; docker-compose.yml's agent-scheduler service does this
# (AGENT_SCHEDULER_INTERVAL_SECONDS, default 60). The tick also wakes this
# process's worker. Several ticks at once are safe. A workspace admin must turn
# on "Schedules" in Agent settings, and the plan must allow them.

# RAG vector store. Default (unset) = in-app cosine over the doc-embedding
# collection (zero infra, fine on SQLite). For scale, set WEBX_VECTOR=pgvector
# and PGVECTOR_URL to a Postgres + pgvector database (also: npm i pg).
WEBX_VECTOR=
PGVECTOR_URL=

# Billing (optional). Leave STRIPE_SECRET_KEY empty to keep self-serve
# upgrades disabled — the UI degrades gracefully to "contact sales". All four
# are required together to actually enable Pro checkout/webhooks:
STRIPE_SECRET_KEY=
# The Price id (price_...) for the Pro plan's $79/mo recurring price, created
# in the Stripe Dashboard — Enterprise has no Price id, it's sales-assisted.
STRIPE_PRICE_ID_PRO=
# Signing secret for the Stripe Dashboard webhook endpoint pointed at
# /api/webhooks/stripe — verifies inbound events are really from Stripe.
STRIPE_WEBHOOK_SECRET=
# Publishable key (reaches the browser — this one is NOT secret) for Stripe
# Elements' payment-method form in Billing.tsx.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
