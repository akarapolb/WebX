{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dga-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "site/DGA-Website"],
      "port": 8080
    },
    {
      "name": "webx-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", "webx-studio/design"],
      "port": 8090
    },
    {
      "name": "webx-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "webx-studio",
      "port": 3000
    },
    {
      "name": "public-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8095", "--directory", "public-site/out"],
      "port": 8095
    }
  ]
}
