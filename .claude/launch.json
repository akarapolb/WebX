{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dga-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "site/DGA-Website"],
      "port": 8080
    },
    {
      "name": "webx-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", "webx-studio/design"],
      "port": 8090
    },
    {
      "name": "webx-studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3001"],
      "cwd": "webx-studio",
      "port": 3001
    },
    {
      "name": "public-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "public-site/out", "-l", "8095"],
      "port": 8095
    },
    {
      "name": "public-site-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "public-site",
      "port": 3100
    }
  ]
}
