{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/news-tabs",
  "title": "WebX: News tabs (ORST)",
  "category": "webx-blocks",
  "icon": "screenoptions",
  "description": "A tabbed news/events section — add \"News tab\" blocks, each with one featured story and a row of side items. Synced into page.acf.blocks as a \"news-tabs\" block.",
  "attributes": {
    "blockId": { "type": "string", "default": "" },
    "eyebrow": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "lead": { "type": "string", "default": "" },
    "viewAllLabel": { "type": "string", "default": "" },
    "viewAllUrl": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "multiple": true },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
