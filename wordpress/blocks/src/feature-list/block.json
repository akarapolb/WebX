{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/feature-list",
  "title": "WebX: Feature list",
  "category": "webx-blocks",
  "icon": "list-view",
  "description": "An icon + title + body feature grid. Synced into page.acf.blocks as a \"feature-list\" block.",
  "attributes": {
    "blockId": { "type": "string", "default": "" },
    "eyebrow": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "lead": { "type": "string", "default": "" },
    "columns": { "type": "string", "default": "3" }
  },
  "supports": { "html": false, "multiple": true },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
