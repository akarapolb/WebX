{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/contact-info",
  "title": "WebX: Contact info",
  "category": "webx-blocks",
  "icon": "phone",
  "description": "Address/phone/email/hours, optionally with an embedded map. Synced into page.acf.blocks as a \"contact-info\" block.",
  "attributes": {
    "blockId": { "type": "string", "default": "" },
    "address": { "type": "string", "default": "" },
    "phone": { "type": "string", "default": "" },
    "email": { "type": "string", "default": "" },
    "hours": { "type": "string", "default": "" },
    "mapEmbed": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "multiple": true },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
