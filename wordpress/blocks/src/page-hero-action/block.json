{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/page-hero-action",
  "title": "WebX: Hero button",
  "category": "webx-blocks",
  "icon": "button",
  "description": "One action button inside a WebX: Page hero block.",
  "parent": ["webx/page-hero"],
  "attributes": {
    "label": { "type": "string", "default": "" },
    "href": { "type": "string", "default": "#" },
    "ghost": { "type": "boolean", "default": false }
  },
  "supports": { "html": false, "multiple": true, "reusable": false },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
