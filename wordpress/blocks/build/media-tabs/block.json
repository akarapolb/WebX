{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/media-tabs",
  "title": "WebX: Media tabs (ORST)",
  "category": "webx-blocks",
  "icon": "screenoptions",
  "description": "A tabbed media/publications hub — add \"Media tab\" blocks, each containing \"Media tab item\" blocks. Synced into page.acf.blocks as a \"media-tabs\" block.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "viewAllLabel": {
      "type": "string",
      "default": ""
    },
    "viewAllUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}