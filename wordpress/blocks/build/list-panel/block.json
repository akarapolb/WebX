{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/list-panel",
  "title": "WebX: List panel (RoyalSociety)",
  "category": "webx-blocks",
  "icon": "list-view",
  "description": "A dated list of link rows, optionally bound to a live WordPress content feed. Synced into page.acf.blocks as a \"list-panel\" block.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "sourceEnabled": {
      "type": "boolean",
      "default": false
    },
    "sourcePostType": {
      "type": "string",
      "default": "news"
    },
    "sourceMap": {
      "type": "string",
      "default": "dated"
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}