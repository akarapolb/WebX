{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/steps",
  "title": "WebX: Steps",
  "category": "webx-blocks",
  "icon": "editor-ol",
  "description": "An auto-numbered ordered list of steps. Synced into page.acf.blocks as a \"steps\" block.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}