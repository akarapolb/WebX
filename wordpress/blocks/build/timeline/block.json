{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/timeline",
  "title": "WebX: Timeline",
  "category": "webx-blocks",
  "icon": "clock",
  "description": "A year-by-year history timeline, optionally bound to a live WordPress content feed. Synced into page.acf.blocks as a \"timeline\" block.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "sourceEnabled": {
      "type": "boolean",
      "default": false
    },
    "sourcePostType": {
      "type": "string",
      "default": "timeline"
    },
    "sourceMap": {
      "type": "string",
      "default": "timeline"
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}