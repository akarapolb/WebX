{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/faq-item",
  "title": "WebX: FAQ item",
  "category": "webx-blocks",
  "icon": "editor-help",
  "description": "One question/answer row inside a WebX: FAQ block.",
  "parent": [
    "webx/faq"
  ],
  "attributes": {
    "q": {
      "type": "string",
      "default": ""
    },
    "a": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true,
    "reusable": false
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}