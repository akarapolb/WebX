{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/rs-contact-info",
  "title": "WebX: Contact info (RoyalSociety)",
  "category": "webx-blocks",
  "icon": "phone",
  "description": "Heading + address/phone/email/hours. Synced into page.acf.blocks as a \"contact-info\" block — separate from ORST's WebX: Contact info since RS's shape has a heading instead of a map embed.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "hours": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}