{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/news-feed",
  "title": "WebX: News feed (RoyalSociety)",
  "category": "webx-blocks",
  "icon": "megaphone",
  "description": "A featured-story-plus-grid news feed — the first item renders as the large featured card, the rest as a grid. Synced into page.acf.blocks as a \"news-feed\" block.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "viewAllLabel": {
      "type": "string",
      "default": ""
    },
    "viewAllUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}