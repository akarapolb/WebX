{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/notice",
  "title": "WebX: Notice",
  "category": "webx-blocks",
  "icon": "warning",
  "description": "A callout/notice box. Synced into page.acf.blocks as a \"notice\" block — see wordpress/mu-plugins/webx-blocks-sync.php.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "variant": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "tone": {
      "type": "string",
      "default": "info"
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}