{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/media-grid",
  "title": "WebX: Media grid",
  "category": "webx-blocks",
  "icon": "format-gallery",
  "description": "A grid of image-led media cards. Synced into page.acf.blocks as a \"media-grid\" block.",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "columns": {
      "type": "string",
      "default": "3"
    },
    "actionLabel": {
      "type": "string",
      "default": ""
    },
    "actionUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}