{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/feature-directory-item",
  "title": "WebX: Feature directory item",
  "category": "webx-blocks",
  "icon": "grid-view",
  "description": "One card inside a WebX: Feature directory (RoyalSociety) block.",
  "parent": [
    "webx/feature-directory"
  ],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "href": {
      "type": "string",
      "default": "#"
    },
    "linkLabel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true,
    "reusable": false
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}