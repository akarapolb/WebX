{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webx/service-hub-item",
  "title": "WebX: Service hub item",
  "category": "webx-blocks",
  "icon": "screenoptions",
  "description": "One service card in a WebX: Service hub (ORST) block.",
  "parent": [
    "webx/service-hub"
  ],
  "attributes": {
    "badge": {
      "type": "string",
      "default": ""
    },
    "time": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "buttonLabel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": true,
    "reusable": false
  },
  "textdomain": "webx-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}