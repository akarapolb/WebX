{
  "kind": "collectionType",
  "collectionName": "datasets",
  "info": {
    "singularName": "dataset",
    "pluralName": "datasets",
    "displayName": "Dataset",
    "description": "ชุดข้อมูลตาราง (rows) สำหรับกราฟ ตาราง และดาวน์โหลด Open Data — เช่น ดัชนีสากล. Tabular data for chart/table blocks and open-data downloads."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "key": {
      "type": "string",
      "required": true,
      "regex": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Stable id used by chart/download blocks and the API, e.g. egdi. A string, not a uid, so two tenants may use the same key (same reason as page.slug).",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "sourceName": {
      "type": "string",
      "description": "Who published the figures, shown under every chart.",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "sourceUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "license": {
      "type": "string",
      "default": "CC BY 4.0",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "fields": {
      "type": "json",
      "description": "Column dictionary: [{ key, label:{th,en}, type:'string'|'number'|'integer', unit? }]",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "rows": {
      "type": "json",
      "description": "The records: [{ <field key>: value, ... }]. Same in every language.",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Checked against the original source. Unverified datasets show a notice on the site.",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "updatedOn": {
      "type": "date",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "updateCycle": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
